#!/usr/bin/env bash
# Local wrapper: run mpdrate on the media server over SSH.
#
# Usage (from this folder):
#   ./mpdrate N            rate the current track N stars (0-5). N=1 also bins+skips it.
#   ./mpdrate N <uri>      rate a specific track (MPD-relative path)
#
# Host override:  MPD_HOST=other.host ./mpdrate 4
set -euo pipefail

HOST="${MPD_HOST:-media.ahiru.pl}"

# Re-quote each argument so it survives the remote shell intact (filenames and
# --restore queries can contain spaces).
remote="mpdrate"
for arg in "$@"; do
    remote+=" $(printf '%q' "$arg")"
done

# Allocate a remote TTY only when we have a local one, so the interactive
# [y/N] prompt works without warnings when piped/non-interactive.
tty_flag=()
[ -t 0 ] && tty_flag=(-t)
exec ssh "${tty_flag[@]+"${tty_flag[@]}"}" "$HOST" "$remote"
